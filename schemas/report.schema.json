{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Check report",
  "description": "Every pre-check and post-check report. $defs.findings is filled from findings.schema.json when loaded (agent/schemas.py).",
  "oneOf": [{"$ref": "#/$defs/precheck"}, {"$ref": "#/$defs/postcheck"}],
  "$defs": {
    "findings": {},
    "nullable_string": {"type": ["string", "null"]},
    "status": {"enum": ["online", "offline", "unknown"]},
    "device_type": {"enum": ["camera", "switch", "pos"]},
    "port": {
      "type": "object", "additionalProperties": false,
      "required": ["port", "state", "label"],
      "properties": {
        "port": {"type": "integer", "minimum": 1},
        "state": {"enum": ["up", "down"]},
        "label": {"$ref": "#/$defs/nullable_string"}
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["device_id", "type", "status"],
      "properties": {
        "device_id": {"type": "string"},
        "type": {"$ref": "#/$defs/device_type"},
        "status": {"$ref": "#/$defs/status"},
        "latency_ms": {"type": ["integer", "null"]},
        "ports": {"type": ["array", "null"], "items": {"$ref": "#/$defs/port"}},
        "error_category": {"enum": ["timeout", "invalid_input", "internal", "not_checked"]},
        "is_retryable": {"type": "boolean"},
        "message": {"type": "string"}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "tokens_by_agent", "untracked_tokens", "consistent"],
      "properties": {
        "source": {"enum": ["transcripts", "unavailable"]},
        "tokens_by_agent": {"type": "object",
                            "additionalProperties": {"type": "object",
                                                     "additionalProperties": {"type": "integer"}}},
        "untracked_tokens": {"type": ["object", "null"],
                             "additionalProperties": {"type": "integer"}},
        "consistent": {"type": ["boolean", "null"]}
      }
    },
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "summary", "is_error", "subtype", "num_turns", "check_calls",
                   "total_cost_usd", "error", "usage"],
      "properties": {
        "model": {"type": "string"},
        "summary": {"$ref": "#/$defs/nullable_string"},
        "is_error": {"type": "boolean"},
        "subtype": {"$ref": "#/$defs/nullable_string"},
        "num_turns": {"type": ["integer", "null"]},
        "check_calls": {"type": "integer", "minimum": 0},
        "total_cost_usd": {"type": ["number", "null"]},
        "error": {"$ref": "#/$defs/nullable_string"},
        "usage": {"$ref": "#/$defs/usage"}
      }
    },
    "findings_error": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["attempts", "errors"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1},
        "errors": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "common": {
      "required": ["kind", "check_id", "site", "created_at", "agent", "event_log",
                   "findings", "findings_error", "findings_attempts"],
      "properties": {
        "check_id": {"type": "string"},
        "site": {"type": "string"},
        "created_at": {"type": "string"},
        "event_log": {"$ref": "#/$defs/nullable_string"},
        "findings": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/findings"}]},
        "findings_error": {"$ref": "#/$defs/findings_error"},
        "findings_attempts": {"type": "integer", "minimum": 0}
      }
    },
    "precheck": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["devices", "baseline_saved"],
      "properties": {
        "kind": {"const": "precheck"},
        "check_id": true, "site": true, "created_at": true, "event_log": true,
        "findings": true, "findings_error": true, "findings_attempts": true,
        "agent": {"$ref": "#/$defs/agent"},
        "devices": {"type": "array", "items": {"$ref": "#/$defs/device"}},
        "baseline_saved": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "diff_device": {
      "type": "object", "additionalProperties": false,
      "required": ["device_id", "type", "baseline_status", "status", "classification"],
      "properties": {
        "device_id": {"type": "string"},
        "type": {"$ref": "#/$defs/device_type"},
        "baseline_status": {"$ref": "#/$defs/status"},
        "status": {"$ref": "#/$defs/status"},
        "classification": {"enum": ["ok", "pre-existing", "recovered", "new_offline", "unknown"]},
        "likely_cause": {"type": "string"}
      }
    },
    "diff": {
      "type": "object", "additionalProperties": false,
      "required": ["devices", "new_ports_down", "blocking", "release_allowed"],
      "properties": {
        "devices": {"type": "array", "items": {"$ref": "#/$defs/diff_device"}},
        "new_ports_down": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false,
                    "required": ["switch_id", "port", "label"],
                    "properties": {"switch_id": {"type": "string"},
                                   "port": {"type": "integer", "minimum": 1},
                                   "label": {"$ref": "#/$defs/nullable_string"}}}
        },
        "blocking": {"type": "array", "items": {"type": "string"}},
        "release_allowed": {"type": "boolean"}
      }
    },
    "agent_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["released", "release_reason", "escalated", "escalate_reason",
                   "escalated_devices", "release_denials"],
      "properties": {
        "released": {"type": "boolean"},
        "release_reason": {"$ref": "#/$defs/nullable_string"},
        "escalated": {"type": "boolean"},
        "escalate_reason": {"$ref": "#/$defs/nullable_string"},
        "escalated_devices": {"type": "array", "items": {"type": "string"}},
        "release_denials": {"type": "array", "items": {"type": "string"}}
      }
    },
    "postcheck": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/common"}],
      "required": ["baseline_check_id", "diff", "agent_decision", "decision", "error"],
      "properties": {
        "kind": {"const": "postcheck"},
        "check_id": true, "site": true, "created_at": true, "event_log": true,
        "findings": true, "findings_error": true, "findings_attempts": true,
        "agent": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/agent"}]},
        "baseline_check_id": {"$ref": "#/$defs/nullable_string"},
        "diff": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/diff"}]},
        "agent_decision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/agent_decision"}]},
        "decision": {"enum": ["release", "hold"]},
        "error": {"$ref": "#/$defs/nullable_string"}
      },
      "additionalProperties": false
    }
  }
}
